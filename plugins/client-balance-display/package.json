{
  "name": "@xsuas/dsh-client-balance-display",
  "version": "0.1.0",
  "description": "DSH 客户端插件：输入框内余额芯片（conversation.input.right）+ 卡片下方会话 token 用量行（conversation.composer.dock）",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "balance",
    "tokens"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
